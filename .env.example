# Copy to .env and fill in. Keys stay on the laptop; the phone never sees them.
OPENAI_API_KEY=            # vision (segment/read) + Realtime voice agent
VISION_MODEL=gpt-4.1-mini        # full size: gpt-4.1
LIVE_MODEL=gpt-realtime-mini       # full size: gpt-realtime
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# VOICE=alloy
GOOGLE_BOOKS_API_KEY=      # optional, raises catalogue quota
EBAY_CLIENT_ID=            # price source (new + used listings). Without it, prices stay blank.
EBAY_CLIENT_SECRET=
MARKER_SIDE_CM=            # printed ArUco side length, MEASURED WITH A RULER. Unset => no dimensions.
SWEEP_TOKEN=               # optional fixed token; random per server start if empty
NGROK_DOMAIN=              # your free static ngrok domain (dashboard.ngrok.com/domains), e.g. name.ngrok-free.app
PUBLIC_ORIGIN=             # set by scripts/run.sh to the tunnel URL
# SWEEPS_DIR=./sweeps
# CACHE_DIR=./cache
